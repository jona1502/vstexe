---
import { signalPoints, signalStages } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section id="signal-path" class="scroll-mt-24 border-t border-white/[0.06] py-24 sm:py-32">
  <div class="container-page">
    <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <!-- Signal flow -->
      <div class="rounded-2xl border border-white/[0.08] bg-ink-900/50 p-6 sm:p-9">
        <ol class="flex flex-col">
          {
            signalStages.map((stage, index) => (
              <li>
                <div
                  class:list={[
                    'rounded-xl border px-5 py-4',
                    stage.kind === 'sink'
                      ? 'border-signal-400/40 bg-signal-400/[0.08]'
                      : 'border-white/[0.08] bg-ink-850',
                  ]}
                >
                  <p
                    class:list={[
                      'text-sm font-medium',
                      stage.kind === 'sink' ? 'text-signal-300' : 'text-mist-100',
                    ]}
                  >
                    {stage.label}
                  </p>
                  <p class="mt-1 font-mono text-[11px] text-mist-600">{stage.meta}</p>
                </div>

                {index < signalStages.length - 1 && (
                  <div class="relative mx-auto h-10 w-px bg-white/10" aria-hidden="true">
                    <span class="signal-dot absolute -left-[3px] size-[7px] rounded-full bg-signal-400 shadow-[0_0_12px_2px_rgba(56,223,224,0.6)]" style={`animation-delay:${index * 700}ms`} />
                  </div>
                )}
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Copy -->
      <div>
        <SectionHeading
          eyebrow="Signal path"
          title="One chain. Every application."
          align="left"
          lead="Build the chain once in VocalChain. Everything downstream just sees an ordinary input device, so the same processed voice reaches whatever you are talking into."
        />

        <ul class="mt-8 space-y-3.5">
          {
            signalPoints.map((point) => (
              <li class="flex gap-3">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="mt-0.5 size-[18px] shrink-0 text-signal-400"
                >
                  <circle cx="10" cy="10" r="8.25" />
                  <path d="m6.5 10.3 2.4 2.4 4.6-5" />
                </svg>
                <span class="text-sm leading-relaxed text-mist-500">{point}</span>
              </li>
            ))
          }
        </ul>

        <p class="mt-8 rounded-xl border border-white/[0.07] bg-ink-900/60 p-4 text-xs leading-relaxed text-mist-600">
          The last stage is a virtual audio cable you install yourself — VB-CABLE, VoiceMeeter,
          Sonar and Wave Link are all recognised. Discord, OBS, Teams and Chromium then read its
          capture side like any other microphone. They are listed as delivery targets, not as
          verified compatibility; <span class="font-mono text-mist-500">docs/VIRTUAL_CABLE.md</span>
          covers the routing.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* A pulse travelling down each connector, staggered per stage. */
  .signal-dot {
    animation: signal-travel 2.1s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes signal-travel {
    0% {
      top: -4px;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 3px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-dot {
      display: none;
    }
  }
</style>
