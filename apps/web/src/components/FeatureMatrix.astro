---
import { featureBenefits, featureMatrix } from '../data/site';
import FeatureIcon from './icons/Feature.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="features" class="scroll-mt-24 py-24 sm:py-32">
  <div class="container-page">
    <SectionHeading
      eyebrow="What you get"
      title="A microphone chain you assemble yourself"
      lead="Five parts, one local signal path. Nothing here depends on a service, a login or a bundled effect you did not choose."
    />

    <!-- Shared hairlines: cards sit in one bordered grid rather than floating apart. -->
    <ul
      class="mt-14 grid overflow-hidden rounded-2xl border border-white/[0.08] bg-ink-900/40 sm:grid-cols-2 lg:grid-cols-5"
    >
      {
        featureMatrix.map((feature) => (
          <li class="group border-b border-white/[0.06] p-6 transition-colors duration-300 last:border-b-0 hover:bg-white/[0.02] sm:border-r sm:[&:nth-child(2n)]:border-r-0 lg:border-r lg:border-b-0 lg:[&:nth-child(2n)]:border-r lg:last:border-r-0">
            <span class="flex size-10 items-center justify-center rounded-xl border border-white/[0.07] bg-ink-850 text-signal-400 transition-colors duration-300 group-hover:border-signal-400/30 group-hover:text-signal-300">
              <FeatureIcon name={feature.icon} class="size-[18px]" />
            </span>
            <h3 class="mt-5 text-sm font-medium text-mist-100">{feature.title}</h3>
            <p class="mt-2 text-[13px] leading-relaxed text-mist-600">{feature.detail}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-white/[0.08] bg-white/[0.06] md:grid-cols-3">
      {
        featureBenefits.map((benefit) => (
          <div class="bg-ink-950 p-7">
            <h3 class="text-[15px] font-medium text-mist-100">{benefit.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist-600">{benefit.detail}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
