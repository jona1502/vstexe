---
/** Line icons for the audio concepts the product actually implements. */
export type FeatureIconName = 'microphone' | 'vst3' | 'waveform' | 'preset' | 'virtual-mic' | 'shield';

interface Props {
  name: FeatureIconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {
    name === 'microphone' && (
      <>
        <rect x="9" y="2.5" width="6" height="11" rx="3" />
        <path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21.5M8.5 21.5h7" />
      </>
    )
  }
  {
    name === 'vst3' && (
      <>
        <rect x="4.5" y="4.5" width="15" height="15" rx="3" />
        <path d="M9 9h6v6H9zM9 1.5v3M15 1.5v3M9 19.5v3M15 19.5v3M1.5 9h3M1.5 15h3M19.5 9h3M19.5 15h3" />
      </>
    )
  }
  {
    name === 'waveform' && (
      <path d="M2 12h2.5M7 6.5v11M11.5 3v18M16 8v8M20.5 10.5v3M23 12h-.5" />
    )
  }
  {
    name === 'preset' && (
      <>
        <path d="M6 3v7M6 14v7M12 3v4M12 11v10M18 3v11M18 18v3" />
        <circle cx="6" cy="12" r="2" />
        <circle cx="12" cy="9" r="2" />
        <circle cx="18" cy="16" r="2" />
      </>
    )
  }
  {
    name === 'virtual-mic' && (
      <>
        <rect x="3" y="7" width="18" height="10" rx="3" />
        <circle cx="8" cy="12" r="2.25" />
        <path d="M13.5 10h4M13.5 14h2.5" />
      </>
    )
  }
  {
    name === 'shield' && (
      <>
        <path d="M12 2.5 4.5 5.5v6c0 4.6 3.1 8.4 7.5 10 4.4-1.6 7.5-5.4 7.5-10v-6L12 2.5Z" />
        <path d="M9 12l2.25 2.25L15.5 10" />
      </>
    )
  }
</svg>
