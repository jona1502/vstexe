---
import fs from 'node:fs';
import AppWindow from './AppWindow.astro';

// Drop a real capture at public/screenshots/app.png and it replaces the
// built representation automatically, no markup change required.
const screenshot = '/screenshots/app.png';
const hasScreenshot = fs.existsSync(new URL(`../../public${screenshot}`, import.meta.url));
---

<section class="relative pb-24 sm:pb-32">
  <div class="container-page">
    <div class="tilt-stage mx-auto max-w-5xl">
      <!-- Accent bloom behind the window, sized to the frame. -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-8 top-8 bottom-0 rounded-[2rem] bg-signal-500/20 blur-[90px]"
      >
      </div>

      <div class="tilt relative rounded-xl border border-white/[0.08] bg-ink-900 p-1.5 shadow-[0_60px_140px_-40px_rgba(0,0,0,0.95)]">
        <div class="overflow-hidden rounded-lg border border-white/[0.06]">
          {
            hasScreenshot ? (
              <img
                src={screenshot}
                alt="The InputRack desktop window with a microphone selected and a VST3 effect chain"
                width="1440"
                height="900"
                class="w-full"
              />
            ) : (
              <div class="aspect-[16/10] w-full sm:aspect-[16/9]">
                <AppWindow />
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Slight fixed recline gives the preview depth without interactive motion. */
  .tilt-stage {
    position: relative;
    perspective: 2000px;
  }

  .tilt {
    transform: rotateX(7deg) scale(0.985);
    transform-origin: top center;
  }

  @media (prefers-reduced-motion: reduce) {
    .tilt {
      transform: none;
    }
  }
</style>
