---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'center' | 'left';
}

const { eyebrow, title, lead, align = 'center' } = Astro.props;
---

<div class:list={['flex max-w-2xl flex-col', align === 'center' ? 'mx-auto items-center text-center' : 'items-start']}>
  <p class="font-mono text-[11px] tracking-[0.22em] text-signal-400 uppercase">{eyebrow}</p>
  <h2 class="mt-4 text-balance text-3xl font-bold tracking-[-0.02em] text-mist-100 sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-pretty leading-relaxed text-mist-500">{lead}</p>}
</div>
