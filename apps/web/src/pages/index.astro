---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProductPreview from '../components/ProductPreview.astro';
import FactMarquee from '../components/FactMarquee.astro';
import FeatureMatrix from '../components/FeatureMatrix.astro';
import SignalPath from '../components/SignalPath.astro';
import Pricing from '../components/Pricing.astro';
import DownloadCta from '../components/DownloadCta.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main class="pt-16">
    <Hero />
    <ProductPreview />
    <FactMarquee />
    <FeatureMatrix />
    <SignalPath />
    <Pricing />
    <DownloadCta />
  </main>
  <Footer />
</Layout>
